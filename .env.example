APP_NAME="Mal Bali Galeria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar
OPERATING_TIMEZONE=Asia/Makassar
PERMIT_STATUS_LINK_EXPIRY_DAYS=30

# Gunakan hostname tanpa skema, pisahkan dengan koma jika lebih dari satu.
# APP_TRUSTED_HOSTS=sik.malbaligaleria.com
HTTP_SECURITY_HEADERS_ENABLED=true
HTTP_HSTS_ENABLED=true
HTTP_HSTS_MAX_AGE=31536000
HTTP_HSTS_INCLUDE_SUBDOMAINS=false
HTTP_HSTS_PRELOAD=false

WAHA_BASE_URL=http://192.168.0.253:3000
WAHA_SESSION=default
WAHA_ALLOWED_HOSTS=192.168.0.253

VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Wajib true pada production HTTPS.
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

BACKUP_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE=01:30
# BACKUP_PATH=/var/backups/sik
# MYSQLDUMP_BINARY=/usr/bin/mysqldump

MALWARE_SCAN_ENABLED=false
CLAMAV_BINARY=/usr/bin/clamdscan
MALWARE_SCAN_TIMEOUT=30

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.malbaligaleria.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="dev@malbaligaleria.com"
MAIL_FROM_NAME="Mal Bali Galeria"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS="${APP_URL}"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
